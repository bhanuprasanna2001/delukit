# Copy to .env and fill in. Never commit .env.

# --- delukit pipeline ---
ENTSOE_API_KEY=
DELUKIT_ALERT_WEBHOOK= # optional, failed-run Slack alerts

# --- delu display + API ---
DELU_PUBLIC_URL=http://localhost:8000

# Email for verifications + contact form. One Resend key covers both:
# it is the HTTPS API key and the SMTP password.
RESEND_API_KEY=
RESEND_FROM=DELU <onboarding@resend.dev>
CONTACT_TO=bhanu.prasanna2001@gmail.com
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS= # empty = reuse RESEND_API_KEY
SMTP_FROM=delu@localhost
DELU_COOKIE_SECURE=0 # set to 1 over https
