# Copy to .env and fill in. Never commit .env.

# --- delukit pipeline ---
# ENTSO-E Transparency API key for load / generation / price sync.
ENTSOE_API_KEY=
# Slack incoming webhook for failed-run alerts. Empty = log-only.
DELUKIT_ALERT_WEBHOOK=

# --- delu display + API ---
# Public URL of the site. Confirmation emails link back to this.
DELU_PUBLIC_URL=http://localhost:8000
# Email delivery for confirmations. Empty SMTP_HOST = links go to the logs.
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM=delu@localhost
# Set to 1 when serving over https.
DELU_COOKIE_SECURE=0
